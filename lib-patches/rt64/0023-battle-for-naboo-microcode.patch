+#define F3DNABOO_G_SETGEOMETRYMODE  0xB7
+#define F3DNABOO_G_ENDDL            0xB8
+#define F3DNABOO_G_SETOTHERMODE_C   0xB9
+#define F3DNABOO_G_SETOTHERMODE     0xBA
+#define F3DNABOO_G_TEXTURE          0xBB
+#define F3DNABOO_G_MOVEWORD         0xBC
+#define F3DNABOO_G_POLYGONS         0xBE
+#define F3DNABOO_G_TRI1             0xBF
+#define F3DNABOO_G_TEXRECT          0xE4
+
+namespace RT64 {
+    namespace GBI_F3DNABOO {
+        void beginDisplayList(State *state, DisplayList **dl);
+        void setup(GBI *gbi);
+    };
+};
