+
+#pragma once
+
+#include "rt64_gbi.h"
+
+// Factor 5's graphics microcode for Star Wars Episode I: Battle for Naboo.
+// Display lists are made of 0x108-byte chunks (a [next, prev] header and 0x100
+// bytes of commands) and the microcode keeps much of its state in DMEM, so this
+// module models the DMEM areas the commands read and write.
+
+#define F3DNABOO_G_MOVEMEM          0x01
+#define F3DNABOO_G_SET_DLIST_ADDR   0x02
+#define F3DNABOO_G_GEOMETRY_GEN     0x05
