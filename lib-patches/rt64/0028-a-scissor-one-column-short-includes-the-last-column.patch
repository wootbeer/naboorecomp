+    // A scissor that ends one column short of the color image's width is taken to its end.
+    // Battle for Naboo's always does (399 of 400, 639 of 640), so nothing it draws or clears
+    // reaches a framebuffer's last column, and what an earlier screen left there stays, in the
+    // render target and (written back) in RAM: on a TV the column is in the overscan, or lost in
+    // the blur. On the 640-wide "A long time ago..." screen the picture starts 19 pixels into
+    // the row, so that column is inside it: a line of stray pixels near the right side (white
+    // ones left by the white logo screens, never cleared by the fades to black). With the
+    // column inside the scissor, the game's own clears and fills cover it like the rest.
+    void RDP::includeLastColumnInScissor() {
+        FixedRect &scissorRect = scissorRectStack[scissorStackSize - 1];
+        if ((colorImage.width > 1) && (scissorRect.lrx == (int32_t(colorImage.width) - 1) * 4)) {
+            scissorRect.lrx += 4;
+        }
+    }
