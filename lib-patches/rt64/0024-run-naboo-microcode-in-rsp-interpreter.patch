+template<u8 e>
+auto RSP::SSV(cr128& vt, cr32& rs, s8 imm) -> void {
+    auto address = rs + imm * 2;
+    auto start = e;
+    auto end = start + 2;
+    for (u32 offset = start; offset < end; offset++) {
