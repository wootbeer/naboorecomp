+        eq = _mm_cmpeq_epi16(vs, vte);
+        ne = _mm_cmpeq_epi16(eq, zero);
+        VCCL = _mm_and_si128(VCOH, eq);
+        VCCL = _mm_or_si128(VCCL, ne);
+        ACCL = _mm_blendv_epi8(vte, vs, VCCL);
+        VCCH = zero;
+        VCOH = zero;
+        VCOL = zero;
+        vd = ACCL;
+#endif
+    }
