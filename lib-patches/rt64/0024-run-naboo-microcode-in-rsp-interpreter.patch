+template<u8 e>
+auto RSP::SUV(cr128& vt, cr32& rs, s8 imm) -> void {
+    auto address = rs + imm * 8;
+    auto start = e;
+    auto end = start + 8;
+    for (u32 offset = start; offset < end; offset++) {
