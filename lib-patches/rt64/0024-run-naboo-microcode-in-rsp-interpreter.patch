+template<u8 e>
+auto RSP::STV(u8 vt, cr32& rs, s8 imm) -> void {
+    auto address = rs + imm * 16;
+    auto start = vt & ~7;
+    auto end = start + 8;
+    auto element = 16 - (e & ~1);
+    auto base = (address & 7) - (e & ~1);
+    address &= ~7;
+    for (u32 offset = start; offset < end; offset++) {
+        RSP_MEM_B(0, address + (base++ & 15)) = vpu.r[offset].byte(element++ & 15);
+        RSP_MEM_B(0, address + (base++ & 15)) = vpu.r[offset].byte(element++ & 15);
+    }
+}
