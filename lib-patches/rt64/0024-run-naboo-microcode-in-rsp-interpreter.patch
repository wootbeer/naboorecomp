+template<u8 e>
+auto RSP::VAND(r128& vd, cr128& vs, cr128& vt) -> void {
+    if constexpr (Accuracy::RSP::SISD) {
+        r128 vte = vt(e);
+        for (u32 n = 0; n < 8; n++) {
+            ACCL.u16(n) = vs.u16(n) & vte.u16(n);
+        }
+        vd = ACCL;
+    }
+
+    if constexpr (Accuracy::RSP::SIMD) {
+#if ARCHITECTURE_SUPPORTS_SSE4_1
+        ACCL = _mm_and_si128(vs, vt(e));
+        vd = ACCL;
+#endif
+    }
+}
