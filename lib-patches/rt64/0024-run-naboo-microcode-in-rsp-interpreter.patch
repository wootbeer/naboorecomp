+template<u8 e>
+auto RSP::MFC2(r32& rt, cr128& vs) -> void {
+    auto hi = vs.byte(e + 0 & 15);
+    auto lo = vs.byte(e + 1 & 15);
+    rt = s16(hi << 8 | lo << 0);
+}
+
+template<u8 e>
+auto RSP::MTC2(cr32& rt, r128& vs) -> void {
+    vs.byte(e + 0) = rt >> 8;
+    if (e != 15) vs.byte(e + 1) = rt >> 0;
+}
