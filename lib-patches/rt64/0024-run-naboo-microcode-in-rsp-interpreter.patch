+        for (u32 n = 0; n < 8; n++) {
+            ACCL.u16(n) = VCCL.set(n, vs.u16(n) != vte.u16(n) || VCOH.get(n)) ? vs.u16(n) : vte.u16(n);
+        }
+        VCCH = zero;  //unverified
+        VCOL = zero;
+        VCOH = zero;
