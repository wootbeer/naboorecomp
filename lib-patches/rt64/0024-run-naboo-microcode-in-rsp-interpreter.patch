+template<u8 e>
+auto RSP::SRV(cr128& vt, cr32& rs, s8 imm) -> void {
+    auto address = rs + imm * 16;
+    auto start = e;
+    auto end = start + (address & 15);
+    auto base = 16 - (address & 15);
+    address &= ~15;
+    for (u32 offset = start; offset < end; offset++) {
+        RSP_MEM_B(0, address++) = vt.byte(offset + base & 15);
