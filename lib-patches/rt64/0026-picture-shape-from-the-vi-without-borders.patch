+    uint16_t RDP::autoAnchorAt(State *state, int32_t x, int32_t y) {
+        advanceAnchorFrame(state->ext.workloadQueue->writeCursor);
+        for (const std::vector<AnchorRegion> &regions : anchorRegions) {
+            for (const AnchorRegion &region : regions) {
+                if ((x >= region.ulx) && (x < region.lrx) && (y >= region.uly) && (y < region.lry)) {
