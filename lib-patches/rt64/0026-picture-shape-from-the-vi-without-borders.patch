+    float VI::displayAspect() const {
+        // The shape the TV gives the picture: the VI stretches its region of the framebuffer
+        // over (hEnd - hStart) dots and (vEnd - vStart) half-lines, out of a 4:3 picture of
+        // 640 dots by 474 half-lines (the usual NTSC region, so a 320x240 game is 4:3).
+        // Battle for Naboo's 400x444 framebuffer is shown at about 1.43, not 0.9.
+        const float regionWidth = float(hRegion.hEnd) - float(hRegion.hStart);
+        const float regionHeight = float(vRegion.vEnd) - float(vRegion.vStart);
+        if ((regionWidth > 0.0f) && (regionHeight > 0.0f)) {
+            return (4.0f / 3.0f) * (regionWidth / 640.0f) / (regionHeight / 474.0f);
+        }
+
+        const hlslpp::uint2 size = fbSize();
+        return (size.y > 0) ? float(size.x) / float(size.y) : (4.0f / 3.0f);
+    }
+
     float VI::xScaleFloat() const {
         return (1024.0f / xTransform.xScale);
     }
