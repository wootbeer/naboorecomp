 // (ultramodern::set_running_thread_address). Kept up to date as threads run.
 static PTR(PTR(OSThread)) running_thread_address = NULLPTR;
 
+// Each game thread's host context, kept here rather than only in the OSThread in game
+// memory: the OSThread's context field overlays the space libultra keeps a thread's saved
+// registers in, and a game writing there would leave a garbage host pointer that a thread
+// switch then follows. The field is still written, and checked against this table, so such
+// a write is reported (once per thread) instead of crashing. Also the list of threads for
+// debug_dump_threads.
+static std::mutex thread_contexts_mutex;
+static std::unordered_map<OSThread*, UltraThreadContext*> thread_contexts;
+
+static void set_thread_context(OSThread* t, UltraThreadContext* context) {
+    std::lock_guard lock{ thread_contexts_mutex };
+    thread_contexts[t] = context;
+    t->context = context;
+}
+
+static UltraThreadContext* thread_context_of(OSThread* t) {
+    std::lock_guard lock{ thread_contexts_mutex };
+    auto it = thread_contexts.find(t);
+    UltraThreadContext* context = (it != thread_contexts.end()) ? it->second : nullptr;
+    if (t->context != context) {
+        static std::unordered_map<OSThread*, bool> reported;
+        if (!reported[t]) {
+            reported[t] = true;
+            fprintf(stderr, "[ultramodern] Thread %d's OSThread was overwritten: its context field holds %p, not %p\n", t->id, (void*)t->context, (void*)context);
+            fflush(stderr);
+        }
+        t->context = context;
+    }
+    return context;
+}
+
+void ultramodern::debug_dump_threads(RDRAM_ARG1) {
+    std::lock_guard lock{ thread_contexts_mutex };
+    if (running_thread_address != NULLPTR) {
+        fprintf(stderr, "[ultramodern] Running thread (osRunningThread): 0x%08X\n", (uint32_t)*TO_PTR(PTR(OSThread), running_thread_address));
+    }
+    for (const auto& [t, context] : thread_contexts) {
+        const uint32_t address = 0x80000000u | uint32_t(reinterpret_cast<uint8_t*>(t) - rdram);
+        const char* state = "?";
+        switch (t->state) {
+        case OSThreadState::STOPPED: state = "stopped"; break;
+        case OSThreadState::QUEUED: state = "queued to run"; break;
+        case OSThreadState::RUNNING: state = "running"; break;
+        case OSThreadState::BLOCKED: state = "blocked"; break;
+        }
+        fprintf(stderr, "[ultramodern] Thread %d at 0x%08X: priority %d, %s, ", t->id, address, t->priority, state);
+        if (t->queue == ultramodern::running_queue) {
+            fprintf(stderr, "in the running queue");
+        }
+        else if (t->queue != NULLPTR) {
+            // The queue is a message queue's blocked_on_recv (its first word) or blocked_on_send.
+            const uint32_t q = uint32_t(t->queue);
+            fprintf(stderr, "in queue 0x%08X (as recv: %d of %d messages; as send: %d of %d)", q,
+                *TO_PTR(int32_t, q + 8), *TO_PTR(int32_t, q + 16), *TO_PTR(int32_t, q + 4), *TO_PTR(int32_t, q + 12));
+        }
+        else {
+            fprintf(stderr, "in no queue");
+        }
+        fprintf(stderr, ", next 0x%08X, context %s\n", (uint32_t)t->next, (context == nullptr) ? "none (destroyed)" : ((t->context == context) ? "ok" : "OVERWRITTEN"));
+    }
+    fprintf(stderr, "[ultramodern] Running queue:");
+    for (PTR(OSThread) cur = ultramodern::thread_queue_peek(PASS_RDRAM ultramodern::running_queue); cur != NULLPTR; cur = TO_PTR(OSThread, cur)->next) {
+        fprintf(stderr, " %d", TO_PTR(OSThread, cur)->id);
+    }
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
