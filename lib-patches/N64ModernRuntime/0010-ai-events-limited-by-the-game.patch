diff --git a/ultramodern/src/audio.cpp b/ultramodern/src/audio.cpp
index 81cdac9..8e16771 100644
--- a/ultramodern/src/audio.cpp
+++ b/ultramodern/src/audio.cpp
@@ -35,7 +35,7 @@ static std::atomic<uint32_t> ai_last_buffer_bytes{ 0 };
 static constexpr uint32_t ai_target_ms = 75;
 static constexpr uint32_t ai_max_events_per_vi = 3;
 
-uint32_t ultramodern::ai_events_due() {
+static uint32_t ai_events_wanted() {
     const uint32_t buffer_bytes = ai_last_buffer_bytes.load();
     if (buffer_bytes == 0 || audio_callbacks.get_frames_remaining == nullptr) {
         // Nothing queued yet: one per VI, to start the game off.
@@ -52,6 +52,22 @@ uint32_t ultramodern::ai_events_due() {
     return std::min(due, ai_max_events_per_vi);
 }
 
+// On the N64 the AI and the VI run off the same clock, so a game that makes its audio once
+// per VI can't fall behind the AI unless it misses VIs. Here the AI follows the PC's sound
+// card instead, and a game thread held up for a VI or two (by a long graphics task, say)
+// lets it run ahead: a game that plays from a ring of buffers then plays ones it hasn't
+// refilled yet, a loop of old audio heard as a squeal (Battle for Naboo). Such a game can
+// say how far ahead the AI may go; past that, playback waits for it (a short gap) instead.
+uint32_t ultramodern::ai_events_due(uint32_t pending) {
+    uint32_t due = ai_events_wanted();
+    if (audio_callbacks.get_ai_events_allowed != nullptr) {
+        // Interrupts the game hasn't taken yet will advance it as far as new ones would.
+        const uint32_t allowed = audio_callbacks.get_ai_events_allowed();
+        due = std::min(due, allowed > pending ? allowed - pending : 0);
+    }
+    return due;
+}
+
 void ultramodern::queue_audio_buffer(RDRAM_ARG PTR(int16_t) audio_data_, uint32_t byte_count) {
     ai_last_buffer_bytes.store(byte_count);
 
