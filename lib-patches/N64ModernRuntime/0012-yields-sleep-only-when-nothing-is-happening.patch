+// A yield with no other thread to run: delivers pending events and lets a higher-priority
+// thread run. A thread calling it in a loop is waiting for something another thread or an
+// event will change. While nothing has happened since its previous call (no event came in, no
+// read started, no progress reported by a hook: ultramodern_activity), the call first sleeps
+// until the next event, 1 ms at most, so the loop doesn't burn a core. When something has, it
+// returns at once: only one game thread runs at a time, so a sleep here stops all of them,
+// and Battle for Naboo's file loader yields after every chunk it reads and every step of a
+// request (asleep at each one, a level took 3 s to load instead of 0.4 s).
+// NABOO_YIELD_ALWAYS_SLEEP=1 sleeps on every call, as before, for comparison.
 extern "C" void yield_self_1ms(RDRAM_ARG1) {
-    ultramodern::wait_for_external_message_timed(PASS_RDRAM1, 1);
+    static const bool always_sleep = getenv("NABOO_YIELD_ALWAYS_SLEEP") != nullptr;
+    thread_local uint32_t last_activity = 0;
+    const uint32_t activity = ultramodern_activity.load(std::memory_order_relaxed);
+    if ((activity == last_activity) || always_sleep) {
+        ultramodern::wait_for_external_message_timed(PASS_RDRAM1, 1);
+    }
+    else {
+        dequeue_external_messages(PASS_RDRAM1);
+    }
+
+    // As it was when this call began: what happens during it counts for the next one.
+    last_activity = activity;
