diff --git a/librecomp/src/overlays.cpp b/librecomp/src/overlays.cpp
index 8c8e5d1..0e57a52 100644
--- a/librecomp/src/overlays.cpp
+++ b/librecomp/src/overlays.cpp
@@ -364,9 +364,14 @@ recomp_func_t* recomp::overlays::get_func_by_section_rom_function_vram(uint32_t
 extern "C" recomp_func_t * get_function(int32_t addr) {
     auto func_find = func_map.find(addr);
     if (func_find == func_map.end()) {
-        fprintf(stderr, "Failed to find function at 0x%08X\n", addr);
-        assert(false);
-        std::exit(EXIT_FAILURE);
+        // Say which address, in a message box as well: release builds on Windows have no
+        // console. quick_exit, not exit, so static destructors don't run under the game's
+        // still-running threads.
+        char message[128];
+        snprintf(message, sizeof(message), "Failed to find function at 0x%08X", (uint32_t)addr);
+        fprintf(stderr, "%s\n", message);
+        ultramodern::error_handling::message_box(message);
+        ultramodern::error_handling::quick_exit(__FILE__, __LINE__, __FUNCTION__);
     }
     return func_find->second;
 }
