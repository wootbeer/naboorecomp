+// Defined in ultramodern (mesgqueue.cpp, scheduling.cpp) without a header.
+void dequeue_external_messages(uint8_t* rdram);
+void swap_to_thread(uint8_t* rdram, OSThread* to);
+extern "C" void yield_self_1ms(uint8_t* rdram);
+
+// osYieldThread, as in libultra: hand the CPU to the next ready thread of the
+// same or higher priority. Battle for Naboo's idle thread loops on it, and
+// its file loader yields on every pass. The runtime's own scheduler only
+// ever switches to a strictly higher priority, so do the swap here. With
+// nothing else ready, wait up to 1 ms for an event instead, so an idle loop
+// doesn't burn a core.
 extern "C" void osYieldThread_recomp(uint8_t * rdram, recomp_context * ctx) {
-    assert(false);
-    // osYieldThread(rdram);
+    dequeue_external_messages(rdram);
+    if (!ultramodern::thread_queue_empty(rdram, ultramodern::running_queue)) {
+        OSThread* next = TO_PTR(OSThread, ultramodern::thread_queue_peek(rdram, ultramodern::running_queue));
+        OSThread* self = TO_PTR(OSThread, ultramodern::this_thread());
+        if (next->priority >= self->priority) {
+            ultramodern::thread_queue_pop(rdram, ultramodern::running_queue);
+            swap_to_thread(rdram, next);
+            return;
+        }
+    }
+    yield_self_1ms(rdram);
 }
 
