diff --git a/ultramodern/src/events.cpp b/ultramodern/src/events.cpp
index d8f33e5..b882130 100644
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 #include <thread>
 #include <atomic>
 #include <chrono>
@@ -380,7 +381,20 @@ void gfx_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_re
                 // start another graphics task until the RDP is also complete. Games usually preserve the RSP inputs until the RDP
                 // is finished as well, so sending this early shouldn't be an issue in most cases.
                 // If this causes issues then the logic can be replaced with responding to yield requests.
-                sp_complete();
+                // Battle for Naboo recomp: not this game. Once told the RSP is done it starts on the next
+                // frame, reusing what the display list still points to for short-lived things (a
+                // bolt's matrix, an effect's texture), and the renderer, still reading the list, drew
+                // those from the next frame's data: flat squares, bolts streaking from behind the
+                // craft. So the RSP is done when the display list has been read.
+                // NABOO_SP_COMPLETE_EARLY=1 is the stock order.
+                static const bool sp_complete_early = []() {
+                    const char* value = std::getenv("NABOO_SP_COMPLETE_EARLY");
+                    return (value != nullptr) && (value[0] == '1');
+                }();
+
+                if (sp_complete_early) {
+                    sp_complete();
+                }
                 ultramodern::measure_input_latency();
 
                 PTR(u64) displaylist = task_action->task.t.data_ptr;
@@ -390,6 +404,10 @@ void gfx_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_re
                 renderer_context->send_dl(&task_action->task);
                 [[maybe_unused]] auto renderer_end = std::chrono::high_resolution_clock::now();
 
+                if (!sp_complete_early) {
+                    sp_complete();
+                }
+
                 dp_complete();
                 // TODO hook the parsed event up to the actual parsing point when a callback is added to RT64.
                 ultramodern::extensions::on_displaylist_parsed(displaylist);
